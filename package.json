    "build": "node scripts/build-site.mjs",
    "prepreview:lan": "node scripts/development-command.mjs run build",
    "preview:lan": "node scripts/development-command.mjs exec -- docusaurus serve --host 0.0.0.0 --port 3000 --no-open",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "pretypecheck": "npm run sync",
    "typecheck": "tsc",
    "test:ui": "node --test scripts/test-ui-integration.mjs scripts/test-ux-lint.mjs",
    "lint:ux": "node scripts/verify-ux-lint.mjs",
    "lint:design": "node scripts/design-system/lint.mjs",
    "design:fix": "node scripts/design-system/lint.mjs --fix",
    "content:check": "node scripts/content-format.mjs",
    "content:format": "node scripts/content-format.mjs --write",
    "content:migrate": "node scripts/content-format.mjs --migrate --write",
    "content:new": "node scripts/content-new.mjs",
    "hooks:install": "node scripts/design-system/install-hook.mjs",
    "hooks:check": "node scripts/design-system/precommit.mjs",
    "test:design": "node --test scripts/test-design-system.mjs",
    "test:hook:integration": "node scripts/design-system/verify-hook-fixture.mjs",
    "test:content": "node --test scripts/test-content-network.mjs scripts/test-about-access.mjs scripts/test-publication.mjs scripts/test-content-last-update.mjs scripts/test-document-graph.mjs",
    "test:publication": "node scripts/verify-publication.mjs",
    "test:wiki": "node scripts/verify-wiki.mjs",
    "test:breadcrumbs": "node scripts/verify-breadcrumbs.mjs",
    "test:homepage": "node scripts/verify-homepage.mjs",
    "test:labs-breadcrumbs": "node scripts/verify-labs-breadcrumbs.mjs",
    "sync": "node scripts/sync-locked.mjs",
    "prestart": "node scripts/development-command.mjs run sync",
    "dev": "node scripts/dev-all.mjs",
    "predev:ko": "node scripts/development-command.mjs run sync",
    "predev:en": "node scripts/development-command.mjs run sync",
    "dev:ko": "node scripts/development-command.mjs exec -- concurrently -k -n sync,site \"node scripts/sync-content.mjs --watch\" \"docusaurus start --host 0.0.0.0\"",
    "dev:en": "node scripts/development-command.mjs exec -- concurrently -k -n sync,site \"node scripts/sync-content.mjs --watch\" \"docusaurus start --host 0.0.0.0 --locale en\"",
