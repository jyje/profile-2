    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@mdx-js/react": "^3.0.0",
    "@module-federation/enhanced": "2.9.2",
    "@radix-ui/react-slot": "1.5.0",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "^19.0.0",
    "concurrently": "^10.0.6",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "proper-lockfile": "^4.1.2",
    "serve-handler": "6.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    },
    "postcss-selector-parser": "7.1.6",
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.7"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "7.0.7"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
