{
  "name": "profile-2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "node scripts/build-site.mjs",
    "prepreview:lan": "npm run build",
    "preview:lan": "docusaurus serve --host 0.0.0.0 --port 3000 --no-open",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "pretypecheck": "npm run sync",
    "typecheck": "tsc",
    "test:ui": "node --test scripts/test-ui-integration.mjs",
    "test:content": "node --test scripts/test-content-network.mjs scripts/test-career-layout.mjs",
    "export:pdf": "node scripts/export-career-pdfs.mjs",
    "sync": "node scripts/sync-locked.mjs",
    "prestart": "npm run sync",
    "dev": "node scripts/dev-all.mjs",
    "dev:ko": "concurrently -k -n sync,site \"node scripts/sync-content.mjs --watch\" \"docusaurus start --host 0.0.0.0\"",
    "dev:en": "concurrently -k -n sync,site \"node scripts/sync-content.mjs --watch\" \"docusaurus start --host 0.0.0.0 --locale en\"",
    "migrate:jekyll": "node scripts/migrate-from-jekyll.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@mdx-js/react": "^3.0.0",
    "@module-federation/enhanced": "2.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "^19.0.0",
    "concurrently": "^10.0.5",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "proper-lockfile": "^4.1.2",
    "serve-handler": "6.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.7"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "7.0.7"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
