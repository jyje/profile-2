{
  "name": "profile-2",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-braces.cjs",
    "test:security": "node --test scripts/test-security-dependencies.mjs scripts/test-dependabot-config.mjs",
    "docusaurus": "docusaurus",
