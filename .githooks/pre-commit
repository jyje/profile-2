#!/bin/sh
set -eu

# Git GUIs such as VS Code start hooks without the user's shell profile, so they
# often see the default Node instead of the one in .nvmrc. Select it here; an
# interactive terminal that already runs Node 26+ skips this block.
node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }
if [ "$(node_major)" -lt 26 ]; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    set +u
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
    nvm use >/dev/null 2>&1 || true
    set -u
  fi
fi

exec node scripts/design-system/precommit.mjs
